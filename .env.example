# ── CineSense-Agent configuration ──────────────────────────────────────────────
# Copy this file to `.env` and fill in what you have. EVERY integration has a
# graceful local fallback, so the system runs end-to-end even with this file empty.

# Node orchestrator (tRPC + WebSocket + REST)
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database. Leave EMPTY to use the built-in in-memory store (no Mongo needed).
# Set to a MongoDB Atlas URI to enable persistence + Atlas Vector Search.
MONGODB_URI=

# Creative Agent — Llama-3 via any OpenAI-compatible endpoint
# (Groq, Together, OpenRouter, Ollama, vLLM, ...). Leave KEY empty to use the
# built-in deterministic screenwriter.
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.groq.com/openai/v1
LLAMA_MODEL=llama-3.1-8b-instant

# Python inference bridge (VideoMAE-v2 / AudioCLIP). Leave empty to use the
# built-in heuristic analysis on the Node side.
PY_INFERENCE_URL=http://localhost:8000

# Shared secret required on the internal ingest endpoint (used by the Rust engine)
INTERNAL_API_KEY=dev-internal-key

# Embeddings for Semantic Cinematic Retrieval
# local (default, deterministic, zero-dependency) | openai
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=128
OPENAI_API_KEY=

# Next.js web app (apps/web/.env.local)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
